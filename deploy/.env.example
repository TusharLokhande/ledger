# Copy to /opt/apps/pocket-ledger/.env and fill in. The real file holds secrets: never commit it.
# Generate: password -> openssl rand -hex 24 | keys -> openssl rand -base64 48 | tr -d '\n'

# Postgres container
POSTGRES_USER=ledger
POSTGRES_PASSWORD=<password>
POSTGRES_DB=ledger

# Azurite blob account, "name:base64key"
AZURITE_ACCOUNTS=ledger:<azurite-key>

# API
ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=ledger;Username=ledger;Password=<password>
ConnectionStrings__BlobStorage=DefaultEndpointsProtocol=http;AccountName=ledger;AccountKey=<azurite-key>;BlobEndpoint=http://azurite:10000/ledger;
Jwt__SigningKey=<signing-key>
Cors__AllowedOrigins__0=https://ledger.efficanova.com
Client__BaseUrl=https://ledger.efficanova.com

# Google sign-in (optional to start; the redirect URI must be registered in Google Cloud console)
Google__ClientId=
Google__ClientSecret=
Google__RedirectUri=https://ledger.efficanova.com/api/auth/google/callback

# OpenTelemetry -> the observability stack's collector
OTEL_SERVICE_NAME=ledger-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://observability-otel:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
